{
  "functions": {
    "api/bungie-proxy.js": { "maxDuration": 30 },
    "api/bungie-auth.js":  { "maxDuration": 30 },
    "api/bungie-stats.js": { "maxDuration": 30 },
    "api/bungie-news.js":  { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/bungie-auth",  "destination": "/api/bungie-auth"  },
    { "source": "/api/bungie-news",  "destination": "/api/bungie-news"  },
    { "source": "/api/bungie-stats", "destination": "/api/bungie-stats" },
    { "source": "/api/bungie-proxy", "destination": "/api/bungie-proxy" }
  ],
  "headers": [
    {
      "source": "/api/bungie-news",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN"                     },
        { "key": "X-Content-Type-Options",  "value": "nosniff"                        },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
